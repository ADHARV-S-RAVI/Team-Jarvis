# Q-SHIELD Environment Configuration (Placeholders Only — Never Commit Real Secrets)
QSHIELD_ENVIRONMENT=local
QSHIELD_DATABASE_URL=sqlite:///./qshield.db
QSHIELD_LOG_LEVEL=INFO
QSHIELD_SESSION_TTL_SECONDS=3600
QSHIELD_KEY_STORE_DIR=.qshield_keys
